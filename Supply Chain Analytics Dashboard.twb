      <aliases enabled='yes' />
      <column caption='Profit Calculation' datatype='real' name='[Calculation_0637457651994624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Revenue generated] - [Manufacturing costs] - [Shipping costs] - [Costs]' />
      </column>
      <column caption='Profit Margin' datatype='real' name='[Calculation_0637457652355073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Revenue generated] - [Manufacturing costs] - [Shipping costs] - [Costs]) / [Revenue generated] * 100' />
      </column>
      <column caption='Defect Rate Category' datatype='string' name='[Calculation_0637457652576260]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Defect rates] &lt; 1 THEN &quot;Low (&lt;1%)&quot;&#13;&#10;ELSEIF [Defect rates] &lt; 3 THEN &quot;Medium (1-3%)&quot;&#13;&#10;ELSE &quot;High (&gt;3%)&quot;&#13;&#10;END' />
      </column>
      <column caption='Price Range' datatype='string' name='[Calculation_0637457652654085]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &lt; 20 THEN &quot;Budget ($0-20)&quot;&#13;&#10;ELSEIF [Price] &lt; 50 THEN &quot;Mid-Range ($20-50)&quot;&#13;&#10;ELSEIF [Price] &lt; 80 THEN &quot;Premium ($50-80)&quot;&#13;&#10;ELSE &quot;Luxury ($80+)&quot;&#13;&#10;END' />
      </column>
      <column caption='On-Time Delivery' datatype='string' name='[Calculation_0637457652772870]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Shipping times] &lt;= 5 THEN &quot;On Time&quot;&#13;&#10;ELSE &quot;Delayed&quot;&#13;&#10;END' />
      </column>
      <column caption='Stock Status' datatype='string' name='[Calculation_0637457652822023]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Stock levels] &lt; 20 THEN &quot;Critical&quot;&#13;&#10;ELSEIF [Stock levels] &lt; 50 THEN &quot;Low&quot;&#13;&#10;ELSE &quot;Adequate&quot;&#13;&#10;END' />
      </column>
      <column caption='Stock_Status ' datatype='string' name='[Calculation_1222672773566464]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Stock levels] &lt; 20 THEN &quot;Critical&quot;&#13;&#10;ELSEIF [Stock levels] &lt; 50 THEN &quot;Low&quot;&#13;&#10;ELSEIF [Stock levels] &lt; 80 THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;High&quot;&#13;&#10;END' />
      </column>
      <column caption='Defect_Category' datatype='string' name='[Calculation_1222672803340290]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([Defect rates]) &gt; 2.4 THEN &quot;High Risk&quot;&#13;&#10;ELSEIF AVG([Defect rates]) &gt; 2.0 THEN &quot;Medium Risk&quot;&#13;&#10;ELSE &quot;Low Risk&quot;&#13;&#10;END' />
      </column>
      <column caption='Number of Records' datatype='integer' name='[Calculation_1222672818020356]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
